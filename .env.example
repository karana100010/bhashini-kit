# Legacy (non-Docker) settings. Prefer config/bhashini.conf, which the Settings page writes and which overrides this file.

# Dhruva inference key (sent as the raw Authorization header value).
BHASHINI_API_KEY=

# Optional. Empty lets Dhruva pick a model by language.
BHASHINI_ASR_SERVICE_ID=
BHASHINI_NMT_SERVICE_ID=
BHASHINI_TTS_SERVICE_ID=
BHASHINI_TTS_GENDER=female
# Per-language overrides, e.g.:
# BHASHINI_ASR_SERVICE_ID_HI=
# BHASHINI_TTS_SERVICE_ID_TA=

# Comma-separated origins allowed to call the proxy when the UI is on a different
# origin, e.g. http://localhost:5173,https://chat.example.com
ALLOWED_ORIGINS=
